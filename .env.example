API_BASE_URL=http://localhost:3500
API_TOKEN=
MONGODB_URI=
MONGODB_DATABASE=Tennis
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_NAME=
DRY_RUN=true
TZ=America/Santiago
# Ruta al ejecutable local de Chrome. Dejar vacío para usar el de Puppeteer.
CHROME_PATH=
WHATSAPP_HEADLESS=false

# info: eventos de operación; debug: agrega detalles del historial y respaldos.
LOG_LEVEL=info

# Opcionales para Compose (no cambian la ejecución nativa):
# DOCKER_API_BASE_URL=http://host.docker.internal:3500
# DOCKER_DRY_RUN=true
# CHROME_NO_SANDBOX=true solo para contenedores; Compose ya lo configura.

# Tiempo máximo para cargar y autenticar WhatsApp Web (30 segundos):
WHATSAPP_AUTH_TIMEOUT_MS=30000
